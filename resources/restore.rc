#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "../abyss_cursor_hide.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ABYSS_VERSION_MAJOR,ABYSS_VERSION_MINOR,ABYSS_VERSION_PATCH,0
 PRODUCTVERSION ABYSS_VERSION_MAJOR,ABYSS_VERSION_MINOR,ABYSS_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Jacob Kozin"
            VALUE "FileDescription", "Abyss Cursor Restore"
            VALUE "FileVersion", ABYSS_VERSION_STRING
            VALUE "InternalName", "RestoreCursor"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jacob Kozin. MIT License."
            VALUE "OriginalFilename", "RestoreCursor.exe"
            VALUE "ProductName", "Abyss Cursor Hide"
            VALUE "ProductVersion", ABYSS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
